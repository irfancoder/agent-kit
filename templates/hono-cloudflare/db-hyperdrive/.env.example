# Copy to .env for local development. Every variable the apps read is listed here
# and validated (apps/api/src/env.ts) before `wrangler dev` starts.

# api (wrangler dev reads this file with --env-file)
PORT=3001
LOG_LEVEL=info
# Local Postgres from docker-compose.yml. Change POSTGRES_PORT (and the port below)
# if 5432 is taken. These are local dev credentials, not secrets.
POSTGRES_PORT=5432
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://kitapp:kitapp@127.0.0.1:5432/kitapp

# web (read by apps/web/rsbuild.config.ts for the dev proxy)
API_URL=http://127.0.0.1:3001
