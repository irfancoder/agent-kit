# Copy to .env for local development. Every variable the apps read is listed here
# and validated (apps/api/src/env.ts) before `wrangler dev` starts.

# api (wrangler dev reads this file with --env-file)
PORT=3001
LOG_LEVEL=info
# The Postgres that Hyperdrive connects to in local dev, which you provide: a local
# install, a container or a hosted database. The kit doesn't start one. e2e runs use
# <database>_e2e on the same server, so the role needs CREATEDB. Wrangler requires a
# password in the URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@127.0.0.1:5432/kitapp

# web (read by apps/web/rsbuild.config.ts: its port, and where the dev proxy sends /api)
WEB_PORT=3000
API_URL=http://127.0.0.1:3001
