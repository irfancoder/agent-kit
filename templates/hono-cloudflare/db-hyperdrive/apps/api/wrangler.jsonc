{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kitapp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "LOG_LEVEL": "info" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the id from `wrangler hyperdrive create` before deploying.
      "id": "00000000000000000000000000000000",
      // Local dev only. CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE overrides it.
      "localConnectionString": "postgres://kitapp:kitapp@127.0.0.1:5432/kitapp",
    },
  ],
}
