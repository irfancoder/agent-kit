# Copy to .env for local development. Every variable the apps read is listed here
# and validated at startup (apps/api/src/env.ts).

# api
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# The Postgres you provide: a local install, a container or a hosted database. The
# kit doesn't start one. e2e runs use <database>_e2e on the same server, so the role
# needs CREATEDB.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kitapp

# web (read by apps/web/rsbuild.config.ts: its port, and where the dev proxy sends /api)
WEB_PORT=3000
API_URL=http://127.0.0.1:3001
