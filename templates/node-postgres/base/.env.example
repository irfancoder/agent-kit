# Copy to .env for local development. Every variable the apps read is listed here
# and validated at startup (apps/api/src/env.ts).

# api
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Local Postgres from docker-compose.yml. Change POSTGRES_PORT (and the port in
# DATABASE_URL) if 5432 is taken. These are local dev credentials, not secrets.
POSTGRES_PORT=5432
DATABASE_URL=postgres://kitapp:kitapp@127.0.0.1:5432/kitapp

# web (read by apps/web/rsbuild.config.ts for the dev proxy)
API_URL=http://127.0.0.1:3001
