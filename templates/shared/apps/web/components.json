{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-irfancoder",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/global.css",
    "baseColor": "neutral",
    "cssVariables": false
  },
  "iconLibrary": "none",
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "utils": "@/lib/utils",
    "hooks": "@/hooks"
  },
  "registries": {
    "@irfancoder": {
      "url": "${IRFANCODER_REGISTRY_URL}/{name}.json",
      "headers": {
        "Authorization": "Bearer ${IRFANCODER_REGISTRY_TOKEN}",
        "Accept": "application/vnd.github.raw+json"
      }
    }
  }
}
