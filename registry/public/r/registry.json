  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "IRFANCODER theme",
      "description": "Design tokens (tokens.css, in Hallmark's token names), their StyleX handles (tokens.stylex.ts), light/dark switching, the cx/sx StyleX helpers, and a test helper that renders in both themes. Every component depends on it.",
