        {
          "path": "items/theme/tokens.css",
          "type": "registry:file",
          "target": "src/styles/tokens.css"
        },
        {
          "path": "items/theme/tokens.stylex.ts",
          "type": "registry:file",
          "target": "src/styles/tokens.stylex.ts"
