{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group minor and patch updates into one weekly PR",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch dependencies",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "e2e packages move together",
      "matchPackageNames": [
        "e2e",
        "@e2e-dev/**"
      ],
      "groupName": "e2e"
    },
    {
      "description": "ui-sdk packages move together",
      "matchPackageNames": [
        "@ui-sdk/**"
      ],
      "groupName": "ui-sdk"
    }
  ],
  "description": "agent-kit itself: the template catalogs (templates/*/pnpm-workspace.yaml) and template package.json files. Generated projects carry their own renovate.json.",
  "ignorePaths": [
    "**/node_modules/**"
  ]
}
